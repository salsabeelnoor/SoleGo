{% comment %}
  Section contract.
  Two-column banner. Each column has a background image, an optional Shopify-hosted
  video, a heading, a subtitle, and a button. From 1024px up on hover-capable screens,
  hovering or focusing a column widens it, plays its video, and reveals the subtitle.
  Below 1024px the columns stack, the subtitle is always shown, and videos stay paused.
  @example
  <!-- Add "Split banner" to the home page, then set an image (and optional video) per column. -->
{% endcomment %}

{% liquid
  assign has_video = false
  for block in section.blocks
    if block.settings.video != blank
      assign has_video = true
    endif
  endfor

  assign is_above_fold = false
  if section.index <= 2
    assign is_above_fold = true
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} .split-banner {
    --split-banner-text-color: {{ section.settings.text_color }};
    --split-banner-overlay-color: {{ section.settings.overlay_color }};
    --split-banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --split-banner-heading-size: {% render 'autoclamp', start_value: section.settings.heading_size_desktop, end_value: section.settings.heading_size_mobile, start_width: 1500, end_width: 320 %};
    --split-banner-text-size: {% render 'autoclamp', start_value: 18, end_value: 16, start_width: 1500, end_width: 320 %};
    --split-banner-button-text-size: {% render 'autoclamp', start_value: 18, end_value: 16, start_width: 1500, end_width: 320 %};
  }
{% endstyle %}

{%- if has_video -%}
  <script
    src="{{ 'split-banner.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{%- endif -%}

<split-banner-component
  class="split-banner split-banner--{{ section.settings.height }}{% if section.settings.expand_on_hover %} split-banner--expand{% endif %}"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign image = block.settings.image
      assign video = block.settings.video

      if is_above_fold
        assign loading = 'eager'
      else
        assign loading = 'lazy'
      endif
      if section.index == 1 and forloop.first
        assign fetch_priority = 'high'
      else
        assign fetch_priority = 'auto'
      endif
    -%}
    <div
      class="split-banner__column"
      ref="columns[]"
      style="--split-banner-image-position: {{ block.settings.image_position_x | default: 50 }}% {{ block.settings.image_position_y | default: 50 }}%;"
      {{ block.shopify_attributes }}
    >
      <div class="split-banner__media">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 2400
            | image_tag:
              widths: '600, 900, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 1024px) 65vw, 100vw',
              loading: loading,
              fetchpriority: fetch_priority,
              class: 'split-banner__media-item',
              alt: image.alt
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'split-banner__media-item split-banner__placeholder' }}
        {%- endif -%}

        {%- if video != blank -%}
          {%- # Decorative: muted, no controls, starts only on hover/focus via split-banner.js. -%}
          {{
            video
            | video_tag:
              autoplay: false,
              loop: true,
              muted: true,
              playsinline: true,
              controls: false,
              preload: 'none',
              class: 'split-banner__media-item split-banner__video',
              aria-hidden: 'true',
              tabindex: '-1'
          }}
        {%- endif -%}
        <span class="split-banner__overlay" aria-hidden="true"></span>
      </div>

      {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
        <div class="split-banner__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="split-banner__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="split-banner__text-wrapper">
              <p class="split-banner__text">{{ block.settings.text | escape | newline_to_br }}</p>
            </div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a
              class="split-banner__button"
              href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
            >
              {{- block.settings.button_label | escape -}}
              <svg class="split-banner__arrow" aria-hidden="true" focusable="false" viewBox="0 0 28 12">
                <path d="M0 6h26M21 1l5 5-5 5" stroke="currentColor" stroke-width="1.2" fill="none"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</split-banner-component>

{% stylesheet %}
  .split-banner {
    --split-banner-min-height: 70svh;
    --split-banner-padding: clamp(1.5rem, 5vw, 6.25rem);

    display: flex;
    flex-direction: column;
    width: 100%;
    color: var(--split-banner-text-color);
  }

  .split-banner--medium {
    --split-banner-min-height: 60svh;
  }
  .split-banner--large {
    --split-banner-min-height: 80svh;
  }
  .split-banner--full_screen {
    --split-banner-min-height: calc(100svh - var(--header-height));
  }

  .split-banner__column {
    position: relative;
    display: flex;
    align-items: flex-end;
    flex: 1 1 0;
    min-width: 0;
    min-height: clamp(26rem, 70svh, 45rem);
    overflow: hidden;
    isolation: isolate;
  }

  .split-banner__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .split-banner__media-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Merchant-chosen crop anchor for the column image (Image position setting). */
  img.split-banner__media-item {
    object-position: var(--split-banner-image-position, center);
  }

  .split-banner__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  /* The video sits over the image and fades in once it is actually playing. */
  .split-banner__video {
    opacity: 0;
    transition: opacity var(--animation-speed-slow) var(--ease-out-quad);
  }

  .split-banner__column[data-playing] .split-banner__video {
    opacity: 1;
  }

  .split-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--split-banner-overlay-color);
    opacity: var(--split-banner-overlay-opacity);
  }

  .split-banner__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
    max-width: 40rem;
    padding: var(--split-banner-padding);
  }

  .split-banner__heading {
    margin: 0;
    font-size: var(--split-banner-heading-size);
    line-height: 1;
    color: inherit;
    overflow-wrap: anywhere;
    text-shadow: 3px 6px 10px rgba(0, 0, 0, 0.12);
  }

  /* Collapsible wrapper so the subtitle can slide in without a fixed height. */
  .split-banner__text-wrapper {
    display: grid;
    grid-template-rows: 1fr;
  }

  .split-banner__text {
    min-height: 0;
    margin: 0;
    overflow: hidden;
    line-height: 1.6;
    color: inherit;
    font-size: var(--split-banner-text-size, 18px);
  }

  .split-banner__button {
    --split-banner-button-light: var(--palette-lightest);
    --split-banner-button-dark: var(--palette-darkest);
    --split-banner-button-sweep: 0.45s cubic-bezier(0.65, 0, 0.35, 1);

    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 16px 24px;
    border: 1px solid var(--split-banner-button-light);
    color: var(--split-banner-button-light);
    font-size: var(--split-banner-button-text-size, 16px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.5px;
    text-decoration: none;
    background-color: transparent;
    background-image: linear-gradient(var(--split-banner-button-light), var(--split-banner-button-light));
    background-repeat: no-repeat;
    background-position: left center;
    background-size: 0% 102%;
    backdrop-filter: blur(10px);

    @media only screen and (max-width: 768px) {
      padding: 14px 20px;
      gap: 12px;
    }
  }

  [dir='rtl'] .split-banner__button {
    background-position: right center;
  }

  .split-banner__button:is(:hover, :focus-visible) {
    color: var(--split-banner-button-dark);
    background-size: 100% 102%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .split-banner__button {
      transition: background-size var(--split-banner-button-sweep), color var(--split-banner-button-sweep),
        transform 0.15s ease;
    }

    .split-banner__button:active {
      transform: scale(0.98);
    }
  }

  .split-banner__button:focus-visible {
    outline: 2px solid var(--split-banner-button-light);
    outline-offset: 3px;
  }

  .split-banner__arrow {
    width: 1.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  [dir='rtl'] .split-banner__arrow {
    transform: scaleX(-1);
  }

  /* Side by side from 1024px. Hover effects only where a pointer can hover. */
  @media screen and (min-width: 1024px) {
    .split-banner {
      flex-direction: row;
      min-height: var(--split-banner-min-height);
    }

    .split-banner__column {
      min-height: var(--split-banner-min-height);
    }
  }

  @media screen and (min-width: 1024px) and (hover: hover) {
    .split-banner__text-wrapper {
      grid-template-rows: 0fr;
      opacity: 0;
      transform: translateY(1.5rem);
      margin-block-end: -1.5rem;
    }

    .split-banner__column:is(:hover, :focus-within) .split-banner__text-wrapper {
      grid-template-rows: 1fr;
      opacity: 1;
      transform: translateY(0);
      margin-block-end: 0;
    }

    .split-banner--expand .split-banner__column:is(:hover, :focus-within) {
      flex-grow: 1.3;
    }
  }

  @media screen and (min-width: 1024px) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .split-banner__column {
      transition: flex-grow 0.6s var(--ease-out-cubic);
    }

    .split-banner__text-wrapper {
      transition: grid-template-rows 0.4s var(--ease-out-cubic), opacity 0.4s var(--ease-out-cubic),
        transform 0.4s var(--ease-out-cubic), margin-block-end 0.4s var(--ease-out-cubic);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.split_banner",
  "tag": "section",
  "class": "split-banner-section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full_screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": "full_screen"
    },
    {
      "type": "checkbox",
      "id": "expand_on_hover",
      "label": "t:settings.split_banner_expand_on_hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "t:settings.split_banner_heading_size_desktop",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "t:settings.split_banner_heading_size_mobile",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:names.split_banner_column",
      "settings": [
        {
          "type": "header",
          "content": "t:content.media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "range",
          "id": "image_position_x",
          "label": "t:settings.x_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.image != blank }}"
        },
        {
          "type": "range",
          "id": "image_position_y",
          "label": "t:settings.y_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.image != blank }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:settings.video",
          "info": "t:info.split_banner_video"
        },
        {
          "type": "header",
          "content": "t:content.text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Men's collection"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.text",
          "default": "Everyday sneakers built for comfort, made to keep up with you from morning commute to late nights out."
        },
        {
          "type": "header",
          "content": "t:content.buttons"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:settings.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.split_banner",
      "blocks": {
        "column_1": {
          "type": "column",
          "settings": {
            "heading": "Men's collection"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "heading": "Women's collection"
          }
        }
      },
      "block_order": ["column_1", "column_2"]
    }
  ]
}
{% endschema %}
